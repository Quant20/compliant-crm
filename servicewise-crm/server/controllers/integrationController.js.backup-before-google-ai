import { createTicketRecord } from "../models/Ticket.js";
export async function receiveEmailTicket(req, res, next) { try { const s = req.body.senderName||req.body.fromName||"Email"; const e = req.body.senderEmail||req.body.from||""; const sub = req.body.subject||"Email"; const msg = req.body.message||req.body.body||req.body.text||""; if (!msg.trim()) { res.status(400); throw new Error("Message required."); } res.status(201).json({ success: true, data: await createTicketRecord({ customerName:s, customerEmail:e, customerPhone:"", subject:sub, description:msg, channel:"Email" }) }); } catch(e) { next(e); } }
export async function receiveWhatsAppTicket(req, res, next) { try { const n = req.body.customerName||req.body.profileName||"WhatsApp"; const p = req.body.customerPhone||req.body.from||""; const msg = req.body.message||req.body.text||""; if (!msg.trim()) { res.status(400); throw new Error("Message required."); } res.status(201).json({ success: true, data: await createTicketRecord({ customerName:n, customerEmail:"", customerPhone:p, subject:req.body.subject||"WhatsApp", description:msg, channel:"WhatsApp" }) }); } catch(e) { next(e); } }
