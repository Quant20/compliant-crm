import { randomUUID } from "node:crypto"; import { readFile, writeFile } from "node:fs/promises"; import { ticketsFile } from "../config/db.js";
async function read() { return Array.isArray(JSON.parse(await readFile(ticketsFile, "utf8"))) ? JSON.parse(await readFile(ticketsFile, "utf8")) : []; }
async function write(t) { await writeFile(ticketsFile, JSON.stringify(t, null, 2), "utf8"); }
function validate(i, partial) { if (!partial) ["customerName","subject","description"].forEach((f) => { if (!String(i[f]||"").trim()) { const e=new Error(f+" required"); e.statusCode=400; throw e; } }); }
export async function listTickets() { return (await read()).sort((a,b) => new Date(b.updatedAt) - new Date(a.updatedAt)); }
export async function findTicketById(id) { return (await read()).find((t) => t.id === id) || null; }
export async function createTicketRecord(input) { validate(input); const now = new Date().toISOString(); const ticket = { id: randomUUID(), ticketNumber: "TKT-"+Date.now().toString().slice(-6), customerName: String(input.customerName).trim(), customerEmail: String(input.customerEmail||"").trim(), customerPhone: String(input.customerPhone||"").trim(), subject: String(input.subject).trim(), description: String(input.description).trim(), department: input.department||"Customer Support", priority: input.priority||"Medium", status: input.status||"Open", assignedAgent: input.assignedAgent||"", category: input.category||"General", channel: input.channel||"Manual", createdAt: now, updatedAt: now, conversations: [], notes: [], history: [{ id: randomUUID(), message: "Ticket created", createdAt: now }] }; const tickets = await read(); tickets.unshift(ticket); await write(tickets); return ticket; }
export async function updateTicketRecord(id, changes) { validate(changes, true); const tickets = await read(); const i = tickets.findIndex((t) => t.id === id); if (i === -1) return null; const cur = tickets[i]; const now = new Date().toISOString(); const msgs = []; if (changes.status && changes.status !== cur.status) msgs.push("Status: "+cur.status+" -> "+changes.status); if (changes.priority && changes.priority !== cur.priority) msgs.push("Priority: "+cur.priority+" -> "+changes.priority); tickets[i] = { ...cur, ...changes, id: cur.id, ticketNumber: cur.ticketNumber, createdAt: cur.createdAt, updatedAt: now, history: [...(cur.history||[]), ...(msgs.length ? msgs : ["Updated"]).map((m) => ({id:randomUUID(),message:m,createdAt:now}))] }; await write(tickets); return tickets[i]; }
export async function removeTicket(id) { const tickets = await read(); const f = tickets.filter((t) => t.id !== id); if (f.length === tickets.length) return false; await write(f); return true; }
